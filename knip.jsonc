{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Entries, project files and plugins (vite, vitest, playwright, eslint) are
  // knip's defaults. Each ignore below says why the finding is not dead code.
  "ignoreIssues": {
    // Vendored shadcn output: keeping each primitive's full export list lets
    // `shadcn add` restore and upgrade the file. An importer-less file still
    // shows up, because only export and type findings are ignored. The
    // hand-written command.tsx keeps shadcn's export names, so it is covered too.
    "src/components/ui/**": ["exports", "types"],
    // Byte-identical with react's copy. React imports the consent, tenant-group,
    // config and key exports this app does not (its consent banner, profile
    // analytics section, route analytics and getting-started card).
    "src/observability/telemetry/index.ts": ["exports", "types"],
    // That barrel re-exports `AnalyticsConsentMode` from here.
    "src/observability/telemetry/config.ts": ["types"],
    // Byte-identical with react's copy. React's capture manifest imports
    // `CaptureState` for its billing page's state shots; this app's manifest
    // does not import it.
    "e2e/capture/types.ts": ["types"],
    // A config file Vite reads by path (`--config`) in playwright.config.ts's webServer command.
    "e2e/harness.vite.config.ts": ["exports"],
  },
  "ignoreFiles": [
    // Type declarations for scripts/*.mjs. TypeScript resolves them in place
    // of the .mjs, so no import names a .d.mts.
    "scripts/*.d.mts",
    // The registry snapshot `pnpm ui:drift` reads as text; nothing imports it.
    "scripts/ui-registry/**",
    // MSW's service worker, fetched by the browser when
    // e2e/harness/harness.tsx calls `setupWorker`.
    "public/mockServiceWorker.js",
    // StyleSeed output, committed because its manifest hashes it
    // (STYLESEED.md); the app does not load it.
    ".styleseed/palettes/members.css",
  ],
  // A shell builtin in the `test:e2e:nginx` script's wait loop, not a binary.
  "ignoreBinaries": ["break"],
  // Run by name in the Dockerfile (`posthog-cli sourcemap inject`) and
  // docker/upload-sourcemaps.sh; never imported.
  "ignoreDependencies": ["@posthog/cli"],
}
