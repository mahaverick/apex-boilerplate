# The dev server's run-time settings. The image takes the same settings, at
# container START, as plain environment variables WITHOUT the VITE_ prefix
# (POSTHOG_KEY, APP_ENVIRONMENT, ...): docker/10-runtime-config.sh validates
# them and writes /runtime-config.js, and the bundle reads nothing else. A
# production bundle never reads a VITE_* value, so one image serves every
# environment. Here, `pnpm dev` and `pnpm preview` serve /runtime-config.js
# from these. All are optional; the README's "Run-time configuration" lists
# each one's pattern.
#
# The API prefix is NOT one: it is fixed at /api/v1 and lives in
# src/constants/routes.ts as API_PREFIX, because nginx.conf's collect location
# and the Google OAuth anchor hardcode it too — a variable that moved only the
# axios base would break Google sign-in and that location silently. See the
# README's "The API prefix is fixed".

# PostHog project key (phc_…), the same project express-boilerplate's
# POSTHOG_PROJECT_KEY names. Unset: no analytics code loads and every call is a
# no-op. Events go through the API's /api/v1/collect proxy, never to PostHog
# directly, so the CSP's connect-src stays 'self'.
VITE_POSTHOG_KEY=

# The PostHog UI host (https://, no path), for links posthog-js builds
# (toolbar, replay). Defaults to https://us.posthog.com; set
# https://eu.posthog.com for an EU project.
VITE_POSTHOG_UI_HOST=

# Validated (comma-separated https:// origins, no spaces) but ignored: Apex
# takes no handoff from a website, so a ?ph_did=&ph_sid= is only stripped from
# the address bar (the README's Analytics section).
VITE_ANALYTICS_HANDOFF_ORIGINS=

# Sent as `environment` on every browser event and exception: lowercase
# letters, digits and dashes. Defaults to development. Use express's APP_ENV
# value, so server and browser issues filter alike.
VITE_APP_ENVIRONMENT=
